event.unique_id: string @index(exact, hash, trigram) @upsert .
event.bl_number: string .
event.sales_order: string .
event.product_id: string .
event.product_name: string .
event.material_code: string .
event.material_type: string .
event.process_date: int .
event.amount: float .
event.version: string .
event.src_path: string .
event.plant: [uid] .
event.client: [uid] .
event.location_subject: [uid] .
event.location_facility_subject: [uid] .
event.source_subject: [uid] @count .
event.source_facility_subject: [uid] @count .
event.production_label: [uid] .
event.unit: [uid] .
event.flag: [uid] .
event.sub_data_source: [uid] .
event.uml: [uid] .
event.mill: [uid] .
event.links: [uid] @reverse .

client.id: string .
plant.name: string .
subject.id: string .
subject.type: string .
subject.master_id: string .
subject.master_type: string .
unit.name: string .
production_label.name: string .
flag.name: string .
sub_data_source.name: string .
uml.id: string .
mill.id: string .

type Event {
  event.unique_id
  event.bl_number
  event.sales_order
  event.product_id
  event.product_name
  event.material_code
  event.material_type
  event.process_date
  event.amount
  event.version
  event.src_path
  event.plant
  event.client
  event.location_subject
  event.location_facility_subject
  event.source_subject
  event.source_facility_subject
  event.production_label
  event.unit
  event.flag
  event.sub_data_source
  event.mill
  event.links
}

type Client {
  client.id
}

type Plant {
  plant.name
}

type Subject {
  subject.id
  subject.type
  subject.master_id
  subject.master_type
}

type Unit {
  unit.name
}

type ProductionLabel {
  production_label.name
}

type Flag {
  flag.name
}

type SubDataSource {
  sub_data_source.name
}

type Uml {
  uml.id
}

type Mill {
  mill.id
}
